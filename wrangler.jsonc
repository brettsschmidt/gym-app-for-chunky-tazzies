{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-app-for-chunky-tazzies",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://gym-app-for-chunky-tazzies.example.com"
    // Set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY via
    //   wrangler secret put NEXT_PUBLIC_SUPABASE_URL
    //   wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY
    //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
    //   wrangler secret put VAPID_PRIVATE_KEY
    //   wrangler secret put NEXT_PUBLIC_VAPID_PUBLIC_KEY
    //   wrangler secret put CRON_SECRET
  }
}
